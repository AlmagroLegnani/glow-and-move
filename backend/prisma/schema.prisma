generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubscriptionStatus {
  trial
  pending_payment
  active
  past_due
  canceled
}

enum RoutineChoice {
  tren_superior
  tren_inferior
}

enum UserRole {
  user
  admin
}

enum BillingMode {
  trimestral
  semestral
  anual
}

enum BlockStatus {
  locked
  scheduled
  active
  completed
}

// Nivel del ejercicio en el catálogo de "Mis videos": principiante (Bloques 1-2), intermedio
// (Bloques 3-4), experto (plan Full / rutina personalizada). Es independiente de en qué
// Routine/RoutineExercise se usa el video — lo carga el entrenador a mano en el admin.
enum VideoLevel {
  principiante
  intermedio
  experto
}

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  passwordHash        String
  firstName           String
  lastName            String
  documentId          String?
  nationality         String?
  phone               String?
  city                String?
  age                 Int?
  heightCm            Decimal?  @db.Decimal(5, 1)
  weightKg            Decimal?  @db.Decimal(5, 1)
  role                UserRole  @default(user)
  // null = inicial del nombre; "preset:<estilo>:<semilla>" = avatar de la galería;
  // "data:image/jpeg;base64,..." = foto subida (recortada a 256x256 en el navegador).
  avatarUrl           String?
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  subscriptions    Subscription[]
  healthProfile    HealthProfile?
  payments         Payment[]
  routines         Routine[]
  dayExecutions    DayExecution[]
  weightLogs       WeightLog[]
  servicePurchases ServicePurchase[]
}

// Historial de peso cargado a mano por el usuario desde "Mi plan". Además del valor en
// User.weightKg (el más reciente, usado para el IMC), esto permite comparar el peso al
// inicio y al final de cada bloque en el informe descargable.
model WeightLog {
  id       Int      @id @default(autoincrement())
  userId   Int
  user     User     @relation(fields: [userId], references: [id])
  weightKg Decimal  @db.Decimal(5, 1)
  loggedAt DateTime @default(now())

  @@index([userId, loggedAt])
}

model Plan {
  id                     Int      @id @default(autoincrement())
  slug                   String   @unique
  name                   String
  priceUsd               Decimal  @db.Decimal(10, 2)
  billingPeriod          String // mensual | semestral | anual
  hasAds                 Boolean  @default(true)
  hasVideoAccess         Boolean  @default(false)
  hasPersonalizedRoutine Boolean  @default(false)
  routineOptions         Int      @default(1)
  features               String[]
  sortOrder              Int      @default(0)

  subscriptions Subscription[]
}

// Catálogo de ejercicios. Sigue llamándose "Video" (la tabla ya existía y "Mis videos" la
// usa tal cual) pero ahora también es la fuente de la que toma RoutineExercise/ExerciseLog
// — así evitamos el catálogo duplicado que existía antes entre este modelo y los ejercicios
// hardcodeados del sistema de bloques.
model Video {
  id            Int            @id @default(autoincrement())
  title         String         @unique
  muscleGroup   RoutineChoice?
  videoUrl      String
  description   String?
  defaultSets   Int?
  defaultReps   Int?
  defaultWeight Decimal?       @db.Decimal(6, 2)
  level         VideoLevel     @default(principiante)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())

  routineExercises RoutineExercise[]
  exerciseLogs     ExerciseLog[]
  serviceVideos    ServiceVideo[]
}

model Subscription {
  id               Int                @id @default(autoincrement())
  userId           Int
  user             User               @relation(fields: [userId], references: [id])
  planId           Int
  plan             Plan               @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(trial)
  routineChoice    RoutineChoice?
  billingMode      BillingMode        @default(trimestral)
  isTrial          Boolean            @default(false)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  mpPreferenceId   String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  payments      Payment[]
  blockProgress BlockProgress[]
  notifications NotificationLog[]
}

// Avisos de vencimiento ya enviados (uno por suscripción/tipo/canal/período). Evita que el
// job diario mande el mismo aviso dos veces, y al renovar cambia periodEnd, así que los
// avisos del período nuevo se vuelven a mandar.
model NotificationLog {
  id             Int          @id @default(autoincrement())
  subscriptionId Int
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  kind           String // expiry_7d | expiry_3d | expiry_1d | expired
  channel        String // email | whatsapp | sms
  periodEnd      DateTime
  sentAt         DateTime     @default(now())

  @@unique([subscriptionId, kind, channel, periodEnd])
}

// Catálogo de bloques del programa anual (1-4), administrable: objetivo, descripción y
// duración. Es el mismo concepto de "Bloque" del prototipo anterior, ahora separado en
// catálogo (esta tabla, igual para todos) + instancia por usuario (BlockProgress).
model Block {
  id            Int      @id @default(autoincrement())
  number        Int      @unique
  name          String
  objective     String
  description   String?
  durationWeeks Int      @default(12)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  blockProgress BlockProgress[]
  routines      Routine[]
}

// Instancia de un Block para una Subscription puntual: estado de desbloqueo, pago vigente,
// semana actual dentro del bloque. Reemplaza al blocks[i] que antes vivía adentro del JSON
// de TrainingProgress.
model BlockProgress {
  id             Int          @id @default(autoincrement())
  subscriptionId Int
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  blockId        Int
  block          Block        @relation(fields: [blockId], references: [id])
  cycle          Int          @default(1) // "año" del programa: al completar el Bloque 4 se vuelve al Bloque 1 con cycle+1
  status         BlockStatus  @default(locked)
  currentWeek    Int          @default(1)
  startedAt      DateTime?
  paidUntil      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  dayExecutions DayExecution[]

  @@unique([subscriptionId, blockId, cycle])
}

// Rutina de un bloque: Día 1..N con sus ejercicios. userId null = plantilla genérica (lo que
// ve el plan Premium); userId seteado = override personalizado para ese usuario puntual (lo
// que habilita la "rutina 100% personalizada" del plan Full, armada/editada por el
// entrenador desde el admin). No modelamos todavía CÓMO se genera esa personalización — sólo
// dejamos la estructura para que el entrenador la cargue a mano vía admin.
model Routine {
  id        Int           @id @default(autoincrement())
  // Una rutina pertenece a un bloque del programa anual o a un servicio complementario.
  blockId   Int?
  block     Block?        @relation(fields: [blockId], references: [id], onDelete: Restrict)
  serviceId Int?
  service   ExtraService? @relation(fields: [serviceId], references: [id])
  userId    Int?
  user      User?         @relation(fields: [userId], references: [id])
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  days RoutineDay[]

  @@index([blockId, userId])
  @@index([serviceId])
}

// Día 1, Día 2, etc. — no representa un día de la semana, sino el N-ésimo entrenamiento de
// la rutina (cada usuario lo hace el día calendario que le queda cómodo).
model RoutineDay {
  id        Int     @id @default(autoincrement())
  routineId Int
  routine   Routine @relation(fields: [routineId], references: [id])
  dayNumber Int
  label     String?
  sortOrder Int     @default(0)

  exercises RoutineExercise[]

  @@unique([routineId, dayNumber])
}

model RoutineExercise {
  id              Int        @id @default(autoincrement())
  routineDayId    Int
  routineDay      RoutineDay @relation(fields: [routineDayId], references: [id])
  videoId         Int
  video           Video      @relation(fields: [videoId], references: [id])
  order           Int        @default(0)
  suggestedSets   Int
  suggestedReps   Int
  suggestedWeight Decimal    @db.Decimal(6, 2)
  suggestedRest   String? // texto libre, ej. "1:30" o "90s"

  @@unique([routineDayId, videoId])
}

// "¿Realizaste este entrenamiento?" — un registro por usuario/bloque/semana/día. Si
// performed=false no se le pide al usuario ningún dato de peso/reps (quedan sin
// ExerciseLog para ese día).
model DayExecution {
  id              Int           @id @default(autoincrement())
  userId          Int
  user            User          @relation(fields: [userId], references: [id])
  blockProgressId Int
  blockProgress   BlockProgress @relation(fields: [blockProgressId], references: [id])
  weekNumber      Int
  dayNumber       Int
  performed       Boolean
  performedAt     DateTime      @default(now())

  exerciseLogs ExerciseLog[]

  @@unique([blockProgressId, weekNumber, dayNumber])
}

// La bitácora en sí: sugerido (snapshot de RoutineExercise al momento de esa ejecución, para
// que un cambio futuro en la rutina no altere el histórico) + real. actualReps/actualWeight
// quedan null si el día no se realizó.
model ExerciseLog {
  id              Int          @id @default(autoincrement())
  dayExecutionId  Int
  dayExecution    DayExecution @relation(fields: [dayExecutionId], references: [id])
  videoId         Int
  video           Video        @relation(fields: [videoId], references: [id])
  suggestedSets   Int
  suggestedReps   Int
  suggestedWeight Decimal      @db.Decimal(6, 2)
  suggestedRest   String?
  actualSets      Int?
  actualReps      Int?
  actualWeight    Decimal?     @db.Decimal(6, 2)
  actualRest      String?
  createdAt       DateTime     @default(now())
}

model HealthProfile {
  id                    Int       @id @default(autoincrement())
  userId                Int       @unique
  user                  User      @relation(fields: [userId], references: [id])
  hasChronicIllness     Boolean   @default(false)
  chronicIllnessDetail  String?
  hasDailyMedication    Boolean   @default(false)
  dailyMedicationDetail String?
  conditionsNotes       String?
  acceptedTerms         Boolean   @default(false)
  acceptedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Payment {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation(fields: [userId], references: [id])
  subscriptionId Int?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  mpPaymentId    String?       @unique
  mpStatus       String?
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD")
  createdAt      DateTime      @default(now())
}

model ContactMessage {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  whatsapp    String?
  documentId  String?
  nationality String?
  reason      String?
  comments    String
  createdAt   DateTime @default(now())
}

// Fila única (id fijo = 1) que dice qué admin está usando el panel ahora mismo. Mientras
// adminUserId esté seteado y lastSeenAt sea reciente, ningún otro admin puede entrar — así
// evitamos que dos personas editen planes/bloques/rutinas al mismo tiempo. Sin relación
// formal a User a propósito, para no tocar ese modelo por una tabla puramente operativa.
model AdminLock {
  id          Int      @id @default(1)
  adminUserId Int?
  lastSeenAt  DateTime @default(now())
}

// Servicios complementarios (Rutina flexibilidad, higiene de columna, antimigraña, etc.). Se
// compran por separado con un pago único y se pueden usar mientras el plan esté activo.
// Contenido: una rutina (Routine con serviceId) + videos del catálogo (ServiceVideo).
model ExtraService {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  description String
  priceUsd    Decimal  @default(2) @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  routines  Routine[]
  videos    ServiceVideo[]
  purchases ServicePurchase[]
}

model ServiceVideo {
  id        Int          @id @default(autoincrement())
  serviceId Int
  service   ExtraService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  videoId   Int
  video     Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  sortOrder Int          @default(0)

  @@unique([serviceId, videoId])
}

// Una compra por usuario y servicio. status: pending (checkout creado) | paid (acreditado).
model ServicePurchase {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id])
  serviceId      Int
  service        ExtraService @relation(fields: [serviceId], references: [id])
  status         String       @default("pending")
  amount         Decimal      @db.Decimal(10, 2)
  mpPreferenceId String?
  mpPaymentId    String?      @unique
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, serviceId])
}
