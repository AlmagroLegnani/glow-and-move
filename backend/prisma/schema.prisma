generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubscriptionStatus {
  trial
  pending_payment
  active
  past_due
  canceled
}

enum RoutineChoice {
  tren_superior
  tren_inferior
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  documentId    String?
  nationality   String?
  phone         String?
  city          String?
  age           Int?
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscriptions Subscription[]
  healthProfile HealthProfile?
  payments      Payment[]
}

model Plan {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  name         String
  priceUsd     Decimal  @db.Decimal(10, 2)
  billingPeriod String  // mensual | semestral | anual
  hasAds       Boolean  @default(true)
  hasVideoAccess Boolean @default(false)
  routineOptions Int    @default(1)
  features     String[]
  sortOrder    Int      @default(0)

  subscriptions Subscription[]
}

model Video {
  id             Int      @id @default(autoincrement())
  title          String   @unique
  muscleGroup    RoutineChoice?
  videoUrl       String
  description    String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
}

model Subscription {
  id                Int                @id @default(autoincrement())
  userId            Int
  user              User               @relation(fields: [userId], references: [id])
  planId            Int
  plan              Plan               @relation(fields: [planId], references: [id])
  status            SubscriptionStatus @default(trial)
  routineChoice     RoutineChoice?
  isTrial           Boolean            @default(false)
  trialEndsAt       DateTime?
  currentPeriodEnd  DateTime?
  mpPreferenceId    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  payments          Payment[]
}

model HealthProfile {
  id                    Int      @id @default(autoincrement())
  userId                Int      @unique
  user                  User     @relation(fields: [userId], references: [id])
  hasChronicIllness     Boolean  @default(false)
  chronicIllnessDetail  String?
  hasDailyMedication    Boolean  @default(false)
  dailyMedicationDetail String?
  conditionsNotes       String?
  acceptedTerms         Boolean  @default(false)
  acceptedAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Payment {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation(fields: [userId], references: [id])
  subscriptionId Int?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  mpPaymentId    String?       @unique
  mpStatus       String?
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD")
  createdAt      DateTime      @default(now())
}

model ContactMessage {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  whatsapp    String?
  documentId  String?
  nationality String?
  reason      String?
  comments    String
  createdAt   DateTime @default(now())
}
