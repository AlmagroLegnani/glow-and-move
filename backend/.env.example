PORT=4000

# Avisos de vencimiento
# Secreto que usa el cron diario (GitHub Actions) para llamar a POST /api/jobs/daily
CRON_SECRET=
# Canales de aviso separados por coma. Por ahora sólo "email" tiene proveedor (Resend);
# "whatsapp" y "sms" quedan preparados para conectar más adelante.
NOTIFY_CHANNELS=email
RESEND_API_KEY=
RESEND_FROM=Glow & Move <onboarding@resend.dev>
